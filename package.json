{
  "name": "artha-atlas-assets",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A comprehensive, research-driven Indian investment encyclopedia covering asset classes, alternative investments, portfolio allocation, quantitative analysis, taxation, interactive financial calculators and risk-adjusted returns.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-table": "^8.21.2",
    "astro": "^7.3.8",
    "echarts": "^6.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "pagefind": "^1.5.2",
    "vitest": "^5.0.4"
  }
}
