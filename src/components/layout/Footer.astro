---
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="w-full bg-[#070b12] border-t border-[#24344d] text-slate-400 mt-20 pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[#24344d]/60">
      <!-- Col 1: Identity & Mission -->
      <div class="lg:col-span-2 space-y-4">
        <a href={baseUrl} class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center text-slate-950 font-black text-base">
            अ
          </div>
          <span class="text-lg font-black tracking-tight text-white">
            ArthaAtlas <span class="text-emerald-400 font-semibold text-sm">India</span>
          </span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          <strong>Explore Every Asset. Understand Every Risk. Build Better Wealth.</strong><br />
          India's independent quantitative research encyclopedia covering 13 asset classes, post-tax returns under Finance Act 2024, alternative credit, and institutional portfolio construction.
        </p>

        <!-- Author Card -->
        <div class="pt-2 flex flex-col gap-1.5 text-xs">
          <div class="text-slate-300 font-semibold">Author & Lead Researcher: Chirag Singhal</div>
          <div class="flex items-center gap-3 text-slate-400">
            <a href="mailto:chirag@oriz.in" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
              <span>✉️</span> chirag@oriz.in
            </a>
            <a href="https://facebook.com/singhal127" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">
              Facebook
            </a>
          </div>
          <div class="pt-2">
            <a
              href="https://buymeacoffee.com/chirag127"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[#1e2c44] hover:bg-[#24344d] border border-[#24344d] text-amber-400 text-xs font-semibold transition-all shadow-sm"
            >
              <span>☕</span> Support Independent Research
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Research & Assets -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Asset Exploration</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={`${baseUrl}assets/cash-deposits`} class="hover:text-emerald-400 transition-colors">Cash & Bank FDs</a></li>
          <li><a href={`${baseUrl}assets/indian-equities`} class="hover:text-emerald-400 transition-colors">Indian Listed Equities</a></li>
          <li><a href={`${baseUrl}assets/mutual-funds-etfs`} class="hover:text-emerald-400 transition-colors">Mutual Funds & ETFs</a></li>
          <li><a href={`${baseUrl}assets/bonds-fixed-income`} class="hover:text-emerald-400 transition-colors">G-Secs & Corporate Bonds</a></li>
          <li><a href={`${baseUrl}assets/p2p-lending`} class="hover:text-emerald-400 transition-colors">P2P Lending Reality</a></li>
          <li><a href={`${baseUrl}assets/gold-silver-commodities`} class="hover:text-emerald-400 transition-colors">SGBs & Gold ETFs</a></li>
          <li><a href={`${baseUrl}assets/real-estate-reits`} class="hover:text-emerald-400 transition-colors">REITs & Real Estate</a></li>
          <li><a href={`${baseUrl}assets/productive-businesses`} class="hover:text-emerald-400 transition-colors">Operating Businesses (ROIC)</a></li>
        </ul>
      </div>

      <!-- Col 3: Quantitative Suite -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Calculators & Tools</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={`${baseUrl}calculators/`} class="hover:text-emerald-400 transition-colors">SIP & Step-Up Compounding</a></li>
          <li><a href={`${baseUrl}calculators/`} class="hover:text-emerald-400 transition-colors">SWP Retirement Sustainability</a></li>
          <li><a href={`${baseUrl}calculators/`} class="hover:text-emerald-400 transition-colors">P2P Realised Return Simulator</a></li>
          <li><a href={`${baseUrl}calculators/`} class="hover:text-emerald-400 transition-colors">Real Estate Yield & Leveraged IRR</a></li>
          <li><a href={`${baseUrl}calculators/`} class="hover:text-emerald-400 transition-colors">Post-Tax Comparison Radar</a></li>
          <li><a href={`${baseUrl}allocation/`} class="hover:text-emerald-400 transition-colors">12 Model Portfolios Lab</a></li>
          <li><a href={`${baseUrl}compare/`} class="hover:text-emerald-400 transition-colors">Multi-Asset Comparison Engine</a></li>
          <li><a href={`${baseUrl}tax/`} class="hover:text-emerald-400 transition-colors">Statutory Tax Centre</a></li>
        </ul>
      </div>

      <!-- Col 4: Platform Integrity -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Transparency & Standards</h4>
        <ul class="space-y-2 text-xs">
          <li><a href={`${baseUrl}sources/`} class="hover:text-emerald-400 transition-colors">Primary Source Register</a></li>
          <li><a href={`${baseUrl}methodology/`} class="hover:text-emerald-400 transition-colors">Mathematical Methodology</a></li>
          <li><a href={`${baseUrl}glossary/`} class="hover:text-emerald-400 transition-colors">Financial Glossary</a></li>
          <li><a href={`${baseUrl}series/`} class="hover:text-emerald-400 transition-colors">30-Series Editorial Roadmap</a></li>
          <li><a href={`${baseUrl}corrections/`} class="hover:text-emerald-400 transition-colors">Report an Error / Correction Policy</a></li>
          <li><a href={`${baseUrl}about/`} class="hover:text-emerald-400 transition-colors">Editorial Philosophy</a></li>
        </ul>
      </div>
    </div>

    <!-- Legal & Statutory Disclosure -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="max-w-3xl leading-relaxed">
        <strong>Strict Educational Research Disclaimer:</strong> ArthaAtlas India is an independent financial research publication author-directed by Chirag Singhal. The content, mathematical models, tax summaries, and financial calculators published herein are intended strictly for educational and analytical purposes. ArthaAtlas India is not a SEBI-registered Investment Adviser (RIA), Research Analyst (RA), Portfolio Manager, or tax consultancy. Capital investments are subject to market risks, credit default risks, and legislative tax changes. Never invest capital without conducting independent due diligence or consulting a qualified fiduciary advisor.
      </div>
      <div class="shrink-0 text-center md:text-right font-mono">
        © {currentYear} ArthaAtlas India. All rights reserved.
      </div>
    </div>
  </div>
</footer>
