---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  summary: string;
  seriesId: string;
  seriesTitle: string;
  readingOrder: number;
  publishedDate: string;
  lastReviewedDate: string;
  author: string;
  category: string;
  readTime: string;
  tags?: string[];
  keyTakeaways?: string[];
  citations?: string[];
  prevArticle?: { slug: string; title: string };
  nextArticle?: { slug: string; title: string };
}

const {
  title,
  summary,
  seriesId,
  seriesTitle,
  readingOrder,
  publishedDate,
  lastReviewedDate,
  author,
  category,
  readTime,
  tags = [],
  keyTakeaways = [],
  citations = [],
  prevArticle,
  nextArticle,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${title} | ArthaAtlas India`} description={summary}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 overflow-x-auto whitespace-nowrap">
      <a href={`${baseUrl}/`} class="hover:text-emerald-400 transition-colors">Home</a>
      <span>/</span>
      <a href={`${baseUrl}/articles`} class="hover:text-emerald-400 transition-colors">Library</a>
      <span>/</span>
      <a href={`${baseUrl}/series/${seriesId}`} class="hover:text-emerald-400 transition-colors">{seriesTitle}</a>
      <span>/</span>
      <span class="text-slate-300 font-medium truncate max-w-xs">{title}</span>
    </nav>

    <!-- Article Header -->
    <header class="mb-10 space-y-4 pb-8 border-b border-[#24344d]">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`${baseUrl}/series/${seriesId}`}
          class="px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold"
        >
          {seriesTitle} • Chapter {readingOrder}
        </a>
        <a
          href={`${baseUrl}/assets/${category}`}
          class="px-2.5 py-1 rounded-full bg-slate-800/80 border border-slate-700/60 text-slate-300 text-xs font-mono uppercase"
        >
          {category}
        </a>
        <span class="text-xs text-slate-500">•</span>
        <span class="text-xs text-slate-400">{readTime} Read</span>
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {tags.map(t => (
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-900 border border-slate-800 text-slate-400">
              #{t}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
        {summary}
      </p>

      <!-- Metadata & Author Line -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4 text-xs text-slate-400">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center font-bold">
            CS
          </div>
          <div>
            <div class="text-slate-200 font-semibold">{author}</div>
            <div class="text-[11px] text-slate-500">Lead Research Analyst</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-[11px] font-mono">
          <span>Published: {publishedDate}</span>
          <span>Last Audited: <strong class="text-emerald-400">{lastReviewedDate}</strong></span>
        </div>
      </div>
    </header>

    <!-- Key Takeaways Executive Box -->
    {keyTakeaways.length > 0 && (
      <section class="mb-10 p-6 rounded-3xl bg-[#162032]/80 border border-emerald-500/30 shadow-lg relative overflow-hidden">
        <div class="absolute -right-8 -top-8 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none" />
        <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-3 flex items-center gap-2">
          <span>⚡</span> Executive Research Takeaways
        </h3>
        <ul class="space-y-2 text-sm text-slate-200">
          {keyTakeaways.map((takeaway) => (
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold shrink-0">✓</span>
              <span class="leading-relaxed">{takeaway}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Main Article Body -->
    <article class="prose prose-invert prose-emerald max-w-none article-body">
      <slot />
    </article>

    <!-- Citations & Primary Sources -->
    {citations.length > 0 && (
      <section class="mt-14 pt-8 border-t border-[#24344d] space-y-4">
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
          <span>📚</span> Primary Statutory & Regulatory Citations
        </h4>
        <ul class="space-y-1.5 text-xs text-slate-400 font-mono">
          {citations.map((cite) => (
            <li class="flex items-center gap-2">
              <span class="text-emerald-500">•</span>
              <span>{cite}</span>
            </li>
          ))}
        </ul>
        <p class="text-[11px] text-slate-500 italic mt-2">
          All statutory claims are mapped to enacted legislation and regulator directives in our central <a href={`${baseUrl}/sources`} class="text-emerald-400 hover:underline">Primary Source Register</a>.
        </p>
      </section>
    )}

    <!-- Correction / Error Reporting Box -->
    <div class="mt-10 p-5 rounded-2xl bg-[#111827] border border-[#24344d] flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        <strong class="text-slate-200 block mb-0.5">Notice an outdated tax rule or calculation error?</strong>
        <span>Help us maintain institutional accuracy by reporting discrepancies to our editorial board.</span>
      </div>
      <a
        href={`${baseUrl}/corrections`}
        class="px-3.5 py-1.5 rounded-xl bg-[#1e2c44] hover:bg-[#24344d] border border-[#24344d] text-emerald-400 font-semibold transition-colors shrink-0 text-center"
      >
        Report a Correction
      </a>
    </div>

    <!-- Next / Previous Article Navigation -->
    <div class="mt-12 pt-8 border-t border-[#24344d] grid grid-cols-1 sm:grid-cols-2 gap-4">
      {prevArticle ? (
        <a
          href={`${baseUrl}/articles/${prevArticle.slug}`}
          class="p-4 rounded-2xl bg-[#162032] hover:bg-[#1e2c44] border border-[#24344d] transition-all group"
        >
          <span class="text-[11px] text-slate-500 block mb-1">← Previous Chapter</span>
          <span class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors line-clamp-1">
            {prevArticle.title}
          </span>
        </a>
      ) : <div />}

      {nextArticle && (
        <a
          href={`${baseUrl}/articles/${nextArticle.slug}`}
          class="p-4 rounded-2xl bg-[#162032] hover:bg-[#1e2c44] border border-[#24344d] transition-all text-right group"
        >
          <span class="text-[11px] text-slate-500 block mb-1">Next Chapter →</span>
          <span class="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors line-clamp-1">
            {nextArticle.title}
          </span>
        </a>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      darkMode: true,
      background: '#0d131f',
      primaryColor: '#162032',
      primaryTextColor: '#f8fafc',
      primaryBorderColor: '#10b981',
      lineColor: '#34d399',
      secondaryColor: '#1e2c44',
      tertiaryColor: '#0f172a',
      nodeBkg: '#162032',
      nodeTextColor: '#f8fafc',
      nodeBorder: '#10b981',
      mainBkg: '#162032',
      textColor: '#f8fafc',
      fontSize: '13px',
      fontFamily: 'ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
    },
    flowchart: {
      htmlLabels: false,
      padding: 12,
    },
    securityLevel: 'loose',
  });

  async function renderMermaidDiagrams() {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre.astro-code[data-language="mermaid"], code.language-mermaid'));
    if (blocks.length === 0) return;

    let index = 0;
    for (const el of blocks) {
      const pre = el.tagName.toLowerCase() === 'pre' ? el : (el.closest('pre') || el);
      if (pre.getAttribute('data-mermaid-processed')) continue;
      pre.setAttribute('data-mermaid-processed', 'true');

      const codeLines = Array.from(pre.querySelectorAll('.line'));
      const rawText = codeLines.length > 0
        ? codeLines.map((l) => l.textContent || '').join('\n')
        : (pre.textContent || '');

      const cleanCode = rawText.trim();
      if (!cleanCode) continue;

      const container = document.createElement('div');
      container.className = 'my-8 p-6 rounded-2xl bg-[#0d131f] border border-[#24344d] flex flex-col items-center justify-center overflow-x-auto shadow-xl not-prose';
      
      const headerLabel = document.createElement('div');
      headerLabel.className = 'text-[10px] font-mono uppercase tracking-wider text-emerald-400 mb-3 self-start flex items-center gap-1.5 opacity-90';
      headerLabel.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Systematic Process Flowchart';
      container.appendChild(headerLabel);

      const renderWrapper = document.createElement('div');
      renderWrapper.className = 'w-full flex justify-center overflow-x-auto';
      container.appendChild(renderWrapper);

      const id = `mermaid-render-${Date.now()}-${index++}`;
      try {
        const { svg } = await mermaid.render(id, cleanCode);
        renderWrapper.innerHTML = svg;
        const svgEl = renderWrapper.querySelector('svg');
        if (svgEl) {
          svgEl.style.maxWidth = '100%';
          svgEl.style.height = 'auto';
          svgEl.classList.add('mx-auto');
        }
        pre.parentNode?.replaceChild(container, pre);
      } catch (err) {
        console.warn('Mermaid rendering failed for block, leaving fallback:', err);
        pre.removeAttribute('data-mermaid-processed');
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
  } else {
    renderMermaidDiagrams();
  }
</script>
