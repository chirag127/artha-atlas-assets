---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categoriesData from '../../data/categories.json';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Explore Every Asset Class | ArthaAtlas India"
  description="Examine the complete spectrum of Indian investment opportunities across 13 core asset classes, from risk-free sovereign paper to high-ROIC operating enterprises."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Header -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
        <span>🧭</span> Complete Indian Investment Taxonomy
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
        The Full Asset Spectrum
      </h1>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        Investigate how each asset class actually works, how money is made, how money is lost, what costs are deducted, and how they compare post-tax.
      </p>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categoriesData.map((cat, idx) => (
        <a
          href={`${baseUrl}assets/${cat.slug}`}
          class="p-6 rounded-3xl bg-[#162032] hover:bg-[#1a273e] border border-[#24344d] hover:border-emerald-500/40 transition-all flex flex-col justify-between group shadow-xl hover:-translate-y-1"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center justify-center font-bold text-sm">
                0{idx + 1}
              </span>
              <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border ${
                cat.riskLevel.includes('Low')
                  ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                  : cat.riskLevel.includes('Medium')
                  ? 'bg-blue-500/10 text-blue-400 border-blue-500/20'
                  : cat.riskLevel.includes('Very High') || cat.riskLevel.includes('Extreme')
                  ? 'bg-rose-500/10 text-rose-400 border-rose-500/20'
                  : 'bg-amber-500/10 text-amber-400 border-amber-500/20'
              }`}>
                {cat.riskLevel} Risk
              </span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
              {cat.name}
            </h3>

            <p class="text-xs text-slate-400 leading-relaxed">
              {cat.shortDescription}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-[#24344d]/60 space-y-2 text-xs font-mono">
            <div class="flex justify-between text-slate-400">
              <span>Expected Nominal Return:</span>
              <strong class="text-emerald-400">{cat.expectedReturnRange}</strong>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>Liquidity Profile:</span>
              <span class="text-slate-300">{cat.liquidity}</span>
            </div>
            <div class="flex justify-between text-slate-400">
              <span>Regulators:</span>
              <span class="text-slate-300 truncate max-w-[160px] text-right">{cat.regulators.join(', ')}</span>
            </div>

            <div class="pt-3 flex items-center justify-between text-xs font-sans text-emerald-400 font-semibold group-hover:translate-x-1 transition-transform">
              <span>Explore Category Deep-Dive</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
