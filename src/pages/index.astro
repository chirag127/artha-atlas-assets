---
import BaseLayout from '../layouts/BaseLayout.astro';
import categoriesData from '../data/categories.json';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const allArticles = await getCollection('articles');
const featuredArticles = allArticles.slice(0, 6);
---

<BaseLayout 
  title="ArthaAtlas India — The Independent Indian Investment & Asset Research Platform"
  description="Explore every asset class. Understand every risk. Comprehensive, research-driven Indian investment encyclopedia, financial calculators, asset allocation lab, and Finance Act 2024 taxation engine."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 border-b border-slate-800/80 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Updated for Finance (No. 2) Act 2024 & SEBI/RBI Directives
        </div>
        <h1 class="text-4xl sm:text-6xl font-serif font-bold text-slate-100 tracking-tight leading-tight mb-6">
          Explore Every Asset.<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">
            Understand Every Risk.
          </span><br/>
          Build Better Wealth.
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 leading-relaxed mb-8 max-w-2xl">
          India's independent, static-first investment research encyclopedia. We deconstruct how money is made, how it is lost, hidden costs, post-tax real compounding, and systematic portfolio allocation.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={`${baseUrl}/compare`} class="px-6 py-3 rounded-xl bg-emerald-500 text-slate-950 font-semibold text-sm hover:bg-emerald-400 transition-colors shadow-lg shadow-emerald-500/20">
            Launch Comparison Engine →
          </a>
          <a href={`${baseUrl}/allocation`} class="px-6 py-3 rounded-xl bg-slate-900 text-slate-200 border border-slate-700 font-semibold text-sm hover:bg-slate-800 transition-colors">
            Asset Allocation Lab
          </a>
          <a href={`${baseUrl}/tax`} class="px-6 py-3 rounded-xl bg-slate-900 text-slate-200 border border-slate-700 font-semibold text-sm hover:bg-slate-800 transition-colors">
            Tax Centre
          </a>
        </div>
      </div>

      <!-- Quick Platform Stats -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-slate-800/60 font-mono">
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-slate-100">13</div>
          <div class="text-xs text-slate-400">Asset Classes Deconstructed</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-emerald-400">35+</div>
          <div class="text-xs text-slate-400">Investable Asset Profiles</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-slate-100">12</div>
          <div class="text-xs text-slate-400">Model Asset Allocations</div>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold text-cyan-400">300+</div>
          <div class="text-xs text-slate-400">Curated Research Roadmap</div>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- 1. Asset Spectrum Navigator (13 Categories) -->
    <section>
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1">Taxonomy of Wealth</div>
          <h2 class="text-3xl font-serif font-bold text-slate-100">The 13 Core Asset Classes</h2>
          <p class="text-sm text-slate-400 mt-1 max-w-2xl">
            A research checklist from liquid sovereign cash equivalents to alternative private debt and productive operating assets.
          </p>
        </div>
        <a href={`${baseUrl}/assets`} class="text-xs font-mono text-emerald-400 hover:text-emerald-300 font-medium">
          View Full Asset Directory →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categoriesData.map(cat => (
          <a 
            href={`${baseUrl}/assets/${cat.id}`}
            class="group bg-slate-900/60 border border-slate-800/80 hover:border-emerald-500/40 rounded-xl p-6 transition-all hover:shadow-lg hover:shadow-emerald-950/20 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono mb-2">
                <span class="text-emerald-400 font-semibold">{cat.regulators[0]}</span>
                <span class="text-slate-500">{cat.liquidity}</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-slate-100 group-hover:text-emerald-400 transition-colors mb-2">
                {cat.name}
              </h3>
              <p class="text-xs text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                {cat.shortDescription}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-400">Return: <strong class="text-slate-200">{cat.expectedReturnRange}</strong></span>
              <span class="text-emerald-400 font-medium group-hover:translate-x-0.5 transition-transform">Explore →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 2. High-Return Research Programme Banner -->
    <section class="bg-gradient-to-r from-amber-950/30 via-slate-900 to-slate-900 border border-amber-900/40 rounded-2xl p-8 relative overflow-hidden">
      <div class="max-w-3xl relative z-10">
        <span class="px-2.5 py-1 rounded text-xs font-mono font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30 mb-3 inline-block">
          Special Research Programme
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-100 mb-3">
          High-Return Asset Research & Risk Underwriting
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mb-6 leading-relaxed">
          High potential gross returns are never free. We quantify the hidden mechanisms behind P2P lending, small-cap survivorship bias, private credit illiquidity, leveraged real estate, and operating businesses. Understand the adverse selection, default waterfalls, and structural failure modes before allocating capital.
        </p>
        <a href={`${baseUrl}/high-return`} class="inline-flex items-center px-5 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-semibold text-xs font-mono transition-colors">
          Explore High-Return Opportunities Framework →
        </a>
      </div>
    </section>

    <!-- 3. Interactive Engines & Calculators Showcase -->
    <section>
      <div class="mb-8">
        <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1">Quantitative Tools</div>
        <h2 class="text-3xl font-serif font-bold text-slate-100">Financial Calculation & Decision Suite</h2>
        <p class="text-sm text-slate-400 mt-1 max-w-2xl">
          No vague estimates. Pure mathematical models running locally in your browser with exact formulas, edge cases, and zero third-party telemetry.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-mono font-bold text-sm mb-3">
              01
            </div>
            <h3 class="text-base font-bold text-slate-100 mb-1">Step-Up SIP & Real Return</h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Models inflation drag and annual contribution step-ups. Compares nominal final wealth against purchasing-power preserved rupees.
            </p>
          </div>
          <a href={`${baseUrl}/calculators#sip`} class="text-xs font-mono text-emerald-400 hover:underline">
            Open SIP Calculator →
          </a>
        </div>

        <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 flex items-center justify-center font-mono font-bold text-sm mb-3">
              02
            </div>
            <h3 class="text-base font-bold text-slate-100 mb-1">P2P Default Waterfall</h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Deconstructs headline 12-14% interest rates against cumulative default rates, platform collection cuts, cash drag, and slab-rate taxes.
            </p>
          </div>
          <a href={`${baseUrl}/calculators#p2p`} class="text-xs font-mono text-rose-400 hover:underline">
            Open P2P Simulator →
          </a>
        </div>

        <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-mono font-bold text-sm mb-3">
              03
            </div>
            <h3 class="text-base font-bold text-slate-100 mb-1">Property Cap Rate & IRR</h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Accurately models stamp duty, maintenance, property tax, vacancy drag, mortgage interest, and capital gains tax on eventual sale.
            </p>
          </div>
          <a href={`${baseUrl}/calculators#rental`} class="text-xs font-mono text-cyan-400 hover:underline">
            Open Property Calculator →
          </a>
        </div>

        <div class="bg-slate-900/70 border border-slate-800 rounded-xl p-5 flex flex-col justify-between">
          <div>
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center font-mono font-bold text-sm mb-3">
              04
            </div>
            <h3 class="text-base font-bold text-slate-100 mb-1">Finance Act 2024 Tax Radar</h3>
            <p class="text-xs text-slate-400 mb-4 leading-relaxed">
              Cross-compares net post-tax returns across 7 asset types under new statutory capital gains and slab income rules.
            </p>
          </div>
          <a href={`${baseUrl}/calculators#tax`} class="text-xs font-mono text-amber-400 hover:underline">
            Open Tax Engine →
          </a>
        </div>
      </div>
    </section>

    <!-- 4. Featured Flagship Research Articles -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <div>
          <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1">Peer-Reviewed Research</div>
          <h2 class="text-3xl font-serif font-bold text-slate-100">Featured Research Studies</h2>
          <p class="text-sm text-slate-400 mt-1">
            Deep-dive treatises with full mathematical formulas, statutory citations, and risk disclosures.
          </p>
        </div>
        <a href={`${baseUrl}/articles`} class="text-xs font-mono text-emerald-400 hover:text-emerald-300 font-medium">
          View All {allArticles.length} Studies →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredArticles.map(art => (
          <a 
            href={`${baseUrl}/articles/${art.id}`}
            class="group bg-slate-900/60 border border-slate-800/80 hover:border-emerald-500/40 rounded-xl p-6 transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-2">
                <span class="text-emerald-400 uppercase font-semibold">{art.data.category}</span>
                <span>•</span>
                <span>{art.data.readTime}</span>
              </div>
              <h3 class="text-lg font-serif font-bold text-slate-100 group-hover:text-emerald-400 transition-colors mb-2">
                {art.data.title}
              </h3>
              <p class="text-xs text-slate-400 line-clamp-3 mb-4 leading-relaxed">
                {art.data.summary}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono text-slate-400">
              <span>Reviewed: {art.data.lastReviewedDate}</span>
              <span class="text-emerald-400 font-medium">Read →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 5. Editorial Roadmap & Transparency -->
    <section class="bg-slate-900/40 border border-slate-800 rounded-2xl p-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-1 block">Editorial Architecture</span>
          <h2 class="text-2xl font-serif font-bold text-slate-100 mb-3">300+ Planned Research Topics Across 13 Series</h2>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            We operate an open, transparent research pipeline. Every planned article has defined prerequisites, mathematical models, and primary regulatory citations before writing commences.
          </p>
          <div class="flex gap-4">
            <a href={`${baseUrl}/series`} class="px-4 py-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-mono hover:bg-emerald-500/20 transition-colors">
              Explore 13 Research Series →
            </a>
            <a href={`${baseUrl}/sources`} class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 text-xs font-mono hover:bg-slate-700 transition-colors">
              Primary Source Register →
            </a>
          </div>
        </div>

        <div class="bg-slate-950/80 border border-slate-800/90 rounded-xl p-6 font-mono text-xs text-slate-300 space-y-3">
          <div class="text-emerald-400 font-semibold mb-2">Editorial Principles & Quality Standard</div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Zero sponsored content or affiliate commission bias</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Primary legislative citations for every tax claim (Income Tax Act 1961)</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>Mathematical formulas rendered in standard KaTeX notation</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-emerald-400">✓</span>
            <span>100% Client-Side Privacy: No user inputs ever leave your browser</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Author, Mission & Reader Support -->
    <section class="border-t border-slate-800/80 pt-12">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <h2 class="text-2xl font-serif font-bold text-slate-100">About the Author & Initiative</h2>
        <p class="text-sm text-slate-300 leading-relaxed">
          ArthaAtlas India is created and curated by <strong class="text-slate-100">Chirag Singhal</strong> as an independent, public-good financial education encyclopedia. The project exists to replace marketing jargon with rigorous financial mathematics, statutory clarity, and transparent risk underwriting.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2 font-mono text-xs">
          <a href="mailto:chirag@oriz.in" class="text-slate-400 hover:text-emerald-400 transition-colors">
            chirag@oriz.in
          </a>
          <span class="text-slate-600">•</span>
          <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 transition-colors font-medium">
            Support on Buy Me a Coffee ☕
          </a>
          <span class="text-slate-600">•</span>
          <a href={`${baseUrl}/methodology`} class="text-slate-400 hover:text-slate-200 transition-colors">
            Methodology & Standards
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
