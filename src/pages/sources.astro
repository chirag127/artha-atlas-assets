---
import BaseLayout from '../layouts/BaseLayout.astro';
import sourcesData from '../data/sources.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Primary Source Register & Legislative Citations | ArthaAtlas India"
  description="Official primary source register citing the Income Tax Department, SEBI, Reserve Bank of India, AMFI, DICGC, PFRDA, and IRDAI."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center text-xs font-mono text-slate-500 mb-6">
      <a href={`${baseUrl}/`} class="hover:text-emerald-400">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-300">Sources Register</span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 border border-slate-700/60 rounded-2xl p-8 shadow-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 mb-4">
        Source Verification Hierarchy
      </div>
      <h1 class="text-3xl sm:text-5xl font-serif font-bold text-slate-100 mb-4">
        The ArthaAtlas Source Register
      </h1>
      <p class="text-lg text-slate-300 max-w-4xl leading-relaxed">
        We do not rely on secondary blog posts or unverified marketing claims. Every tax rule, regulatory cap, and return metric on ArthaAtlas is directly traced to primary statutory legislation, enacted Finance Acts, regulator circulars, and official exchange disclosures.
      </p>

      <div class="mt-6 pt-6 border-t border-slate-800 flex flex-wrap gap-6 font-mono text-xs">
        <div>
          <span class="text-slate-500">Verified Sources:</span>
          <span class="text-emerald-400 font-bold ml-1">{sourcesData.length} Primary Records</span>
        </div>
        <div>
          <span class="text-slate-500">Source Standard:</span>
          <span class="text-slate-200 font-bold ml-1">Statutory Legislation & Official Circulars</span>
        </div>
      </div>
    </div>

    <!-- Source Register Table -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl overflow-hidden">
      <div class="p-6 border-b border-slate-800">
        <h2 class="text-xl font-serif font-bold text-slate-100">Primary Source Records</h2>
        <p class="text-xs text-slate-400 mt-1">Direct official links to primary regulator websites, gazette notifications, and statutory repositories.</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-950/80 text-slate-400 border-b border-slate-800 uppercase tracking-wider">
            <tr>
              <th class="px-6 py-4">Source ID</th>
              <th class="px-6 py-4">Title & Description</th>
              <th class="px-6 py-4">Publishing Authority</th>
              <th class="px-6 py-4">Classification</th>
              <th class="px-6 py-4">Accessed</th>
              <th class="px-6 py-4">Official Link</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            {sourcesData.map(source => (
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 text-emerald-400 font-semibold">{source.sourceId}</td>
                <td class="px-6 py-4 max-w-sm">
                  <div class="font-bold text-slate-200 text-sm font-serif mb-0.5">{source.title}</div>
                  <div class="text-[11px] text-slate-400">{source.factsSupported}</div>
                </td>
                <td class="px-6 py-4 font-semibold text-slate-300">{source.publishingOrganisation}</td>
                <td class="px-6 py-4">
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    {source.isPrimary ? 'Primary' : 'Secondary'}
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-400">{source.dateAccessed}</td>
                <td class="px-6 py-4">
                  <a 
                    href={source.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-emerald-400 hover:text-emerald-300 hover:underline inline-flex items-center gap-1"
                  >
                    Open Source
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>
